# Copy to .env and fill in. Values here are placeholders, not real secrets.

# ── Database (PostgreSQL — e.g. Neon / Vercel Postgres) ───────────────────────
# Pooled connection string, used at runtime.
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.eu-central-1.aws.neon.tech/dbname?sslmode=require"
# Direct (non-pooled) connection, used by `prisma db push` / migrations.
DIRECT_URL="postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/dbname?sslmode=require"

# ── Media storage (Cloudflare R2, S3-compatible) ─────────────────────────────
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="medshop-media"
# Public origin the bucket is served from (r2.dev URL or a custom domain). No trailing slash.
R2_PUBLIC_BASE_URL="https://pub-xxxxxxxx.r2.dev"

# ── Site ────────────────────────────────────────────────────────────────────
# Canonical public origin for SEO (metadata, sitemap, robots, JSON-LD, OG images).
# No trailing slash. Falls back to http://localhost:3000 when unset.
SITE_URL="https://your-shop.com"

# Admin panel (/admin) login password. Change this before deploying.
ADMIN_PASSWORD="changeme123"

# Secret for signing admin session cookies and order-confirmation tokens.
# Generate one with: openssl rand -base64 32
ADMIN_SESSION_SECRET="generate-a-random-32-byte-base64-string"

# ── Optional: new-order notifications ─────────────────────────────────────────
# Stays off until the variables below are set.

# Public base URL of the site, used for the admin deep link inside notifications.
# ADMIN_URL="https://your-shop.com"

# Email via Resend (https://resend.com). FROM must be a verified sender/domain.
# ORDER_NOTIFY_EMAIL_TO accepts one address or a comma-separated list.
# RESEND_API_KEY=""
# ORDER_NOTIFY_EMAIL_FROM="orders@your-shop.com"
# ORDER_NOTIFY_EMAIL_TO=""
